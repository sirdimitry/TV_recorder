#!/bin/sh
# Automatically increases the version before every commit.
# Default bump is patch (X.Y.Z -> X.Y.Z+1). For a deliberate bigger jump on a
# commit, set BUMP=minor (X.Y.Z -> X.Y+1.0) or BUMP=major (X.Y.Z -> X+1.0.0):
#   BUMP=minor git commit -m "..."

set -eu

repo_root=$(git rev-parse --show-toplevel)
version_file="$repo_root/VERSION"
changelog_file="$repo_root/CHANGELOG.md"

current=$(tr -d '[:space:]' < "$version_file")
major=${current%%.*}
remaining=${current#*.}
minor=${remaining%%.*}
patch=${remaining#*.}

level=${BUMP:-patch}
case "$level" in
    major)
        next_version="$(( major + 1 )).0.0"
        ;;
    minor)
        next_version="$major.$(( minor + 1 )).0"
        ;;
    patch)
        next_version="$major.$minor.$(( patch + 1 ))"
        ;;
    *)
        echo "pre-commit: unknown BUMP='$level' (expected patch/minor/major), defaulting to patch" >&2
        next_version="$major.$minor.$(( patch + 1 ))"
        ;;
esac
today=$(date +%F)

printf '%s\n' "$next_version" > "$version_file"
temporary_file=$(mktemp)
{
    sed -n '1,3p' "$changelog_file"
    printf '\n## [%s] - %s\n\n- See the accompanying Git commit message for details.\n' "$next_version" "$today"
    sed -n '4,$p' "$changelog_file"
} > "$temporary_file"
mv "$temporary_file" "$changelog_file"

git add VERSION CHANGELOG.md
