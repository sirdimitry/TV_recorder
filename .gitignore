```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log
logs/

# Environment files
.env
.env.local
*.env.*

# Dependencies
venv/
.venv/
.env/
node_modules/

# Build artifacts
dist/
build/
target/

# Editors/IDEs
.vscode/
.idea/
*.swp
*.swo

# Coverage reports
.coverage
htmlcov/
coverage/

# OS specific
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
```